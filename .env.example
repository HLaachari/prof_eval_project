# Option PostgreSQL : le moteur est détecté grâce au préfixe postgresql://
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/classia_db"
PORT=4173

# Option MySQL/MariaDB avec une URL unique :
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Option MySQL Hostinger avec variables séparées (retirez DATABASE_URL) :
#DB_TYPE=mysql
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_USER=YOUR_HOSTINGER_DATABASE_USER
#DB_PASSWORD=YOUR_HOSTINGER_DATABASE_PASSWORD
#DB_NAME=YOUR_HOSTINGER_DATABASE_NAME

# En production Hostinger :
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production
# APP_USERNAME=professeur
# APP_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

